@Library('yocto-lib@2026.06.1') _

def machineFamilies = getFamilies('stm') + getFamilies('renesas')
def machineOptions = machineFamilies.collectMany { family -> getMachines(family) }
def distroOptions = getDistros()

properties([
    parameters([
        [
            $class: 'ChoiceParameter',
            name: 'MACHINES',
            description: 'Select one or more machines. Or nothing for all.',
            choiceType: 'PT_CHECKBOX',
            filterable: true,
            script: [
                $class: 'GroovyScript',
                script: [
                    sandbox: true,
                    script: "return ${machineOptions.inspect()}"
                ]
            ]
        ],
        [
            $class: 'ChoiceParameter',
            name: 'DISTROS',
            description: 'Select one or more distros. Or nothing for all.',
            choiceType: 'PT_CHECKBOX',
            filterable: true,
            script: [
                $class: 'GroovyScript',
                script: [
                    sandbox: true,
                    script: "return ${distroOptions.inspect()}"
                ]
            ]
        ],
        choice(
            name: 'MODE',
            choices: ['BUILD', 'BUILD + TEST', 'TEST'],
            description: 'Choose mode'
        ),
        booleanParam(
            name: 'BUILD_FEATURES',
            defaultValue: false,
            description: 'Build distro features'
        ),
        booleanParam(
            name: 'CREATE_RELEASE',
            defaultValue: false,
            description: 'Create and publish release'
        )
    ])
])

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '20'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        skipStagesAfterUnstable()
    }

    environment {
        GIT_URL = "${scm.userRemoteConfigs[0].url}"
        BRANCH_NAME =  "${env.TAG_NAME ? 'refs/tags/' + env.TAG_NAME : env.BRANCH_NAME}"
    }

    stages {
        stage('Checkout') {      
            when {
                expression { return params.MODE.contains('BUILD') }
            }

            steps {
                deleteDir()

                checkoutYocto(
                    env.GIT_URL,
                    env.BRANCH_NAME
                )
            }
        }

        stage('Build Combinations') {
            matrix {
                axes {
                    axis {
                        name 'MACHINE'
                        values 'qsmp-1351', 'qsmp-1530', 'qsmp-1570', 'qsmp-2350',
                               'qsmp-2550', 'txmp-1530', 'txmp-1570', 'txmp-1571',
                               'txmp-2550', 'txmp-2570', 'qsrz-g2l0', 'qsrz-g2l1',
                               'txrz-g2l0', 'txrz-g2l1', 'txrz-g2l2'
                    }
                }

                when {
                    expression {
                        def selected = (params.MACHINES ?: '')
                            .split(',')
                            .collect { it.trim() }
                            .findAll { it }

                        return selected.isEmpty() || selected.contains(env.MACHINE)
                    }
                }

                stages {
                    stage('Build') {
                        steps {
                            build job: "yocto-build-machine",
                                parameters: [
                                    string(name: 'WORKSPACE', value: env.WORKSPACE),
                                    string(name: 'MACHINE', value: env.MACHINE),
                                    string(name: 'DISTROS', value: env.DISTROS),
                                    string(name: 'MODE', value: params.MODE),
                                    booleanParam(name: 'BUILD_FEATURES', value: params.BUILD_FEATURES)
                                ],
                                wait: true,
                                propagate: true
                        }
                    }
                }
            }
        }

        stage('Create Release') {
            when {
                allOf {
                    expression { return params.CREATE_RELEASE }
                    expression { return params.MODE.contains('BUILD') }
                    expression { return params.MODE.contains('TEST') }
                    expression { return params.DISTROS.isEmpty() }
                    expression { return env.GIT_URL.contains('github') }
                    expression { return env.TAG_NAME ==~ /^KARO-\d{4}-\d{2}-\d{2}$/ }
                }
            }

            matrix {
                axes {
                    axis {
                        name 'FAMILY'
                        values 'qsmp', 'txmp', 'qsrz', 'txrz'
                    }
                }

                when {
                    expression {
                        def selected = (params.MACHINES ?: '')
                            .split(',')
                            .collect { it.trim() }
                            .findAll { it }

                        return selected.isEmpty() || selected.containsAll(getMachines(env.FAMILY))
                    }
                }

                stages {
                    stage('Publish') {
                        steps {
                            createRelease(env.FAMILY, env.TAG_NAME)
                        }
                    }
                }
            }
        }
    }
}